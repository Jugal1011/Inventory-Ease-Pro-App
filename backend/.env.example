# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017/inventory-ease

# Auth
JWT_SECRET=change-me-to-a-long-random-string

# Cloudinary (or set CLOUDINARY_URL=cloudinary://key:secret@cloud_name)
CLOUDINARY_URL=

# Email — choose ONE transport:
# (a) Generic SMTP (SendGrid, Mailgun, SES, Mailtrap, …). Used when SMTP_HOST is set.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# (b) Gmail OAuth2. Used when SMTP_HOST is empty.
EMAIL_USER=you@gmail.com
CLIENT_ID=
CLIENT_SECRET=
REFRESH_TOKEN=

# Sender shown to recipients (defaults to EMAIL_USER / SMTP_USER)
EMAIL_FROM=
# Where contact-form messages are delivered (defaults to EMAIL_USER / SMTP_USER)
CONTACT_EMAIL=
